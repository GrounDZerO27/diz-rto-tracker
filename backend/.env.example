# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=24h

# App
PORT=3000
APP_URL=https://your-app-domain.com

# SMTP (cPanel — Secure SSL/TLS, recommended)
# Use the bare domain as the outgoing host for port 465 SSL/TLS.
# Some cPanel hosts return ERR_TLS_CERT_ALTNAME_INVALID on the mail.* subdomain;
# check your host's mail client settings for the correct SSL/TLS outgoing server.
SMTP_HOST=your-smtp-host.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@your-domain.com
SMTP_PASS=your_email_password
SMTP_FROM="RTO Tracker <noreply@your-domain.com>"

# SMTP fallback (used only when primary SMTP times out or socket connect fails)
# cPanel local Exim usually accepts localhost:25 without SMTP auth.
SMTP_FALLBACK_ENABLED=true
SMTP_FALLBACK_HOST=localhost
SMTP_FALLBACK_PORT=25
SMTP_FALLBACK_SECURE=false
# Optional fallback auth (leave blank for local Exim)
# SMTP_FALLBACK_USER=
# SMTP_FALLBACK_PASS=